# Copy this file to `.env` before starting the containers

### === Required Config ===

# By default your installation is available on http://localhost
# If you want to expose the installation on a network (private or public)
# you need to have a domain and enable the HTTPS  marked entries in the docker-compose.yml
# and uncomment and set the following
#DOMAIN=          # example: mydomain.tld
#BASE_URL=        # example: https://mydomain.tld
#ACME_EMAIL=      # example: certmanager@mydomain.tld

### === Optional: Google reCAPTCHA ===

# Default keys below work for localhost/private instances
# RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
# RECAPTCHA_SECRET=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET=

### === Accounts: ProgCompJOlivaApi ===

# Users sign in with their ProgCompJOliva nickname + password.
# PROGCOMP_API_URL must be reachable from the browser and the backend; the backend
# fetches the API's public signing key from it (no shared secret needed).
PROGCOMP_API_URL=https://progcomp.joliva.cl:8443
# PROGCOMP_JWT_ISSUER=ProgCompJOlivaApi
# PROGCOMP_JWT_AUDIENCE=ProgCompJOlivaClient

### === Optional: Custom Ports ===

# HTTP_PORT=80
# HTTPS_PORT=443
# FRONTEND_PORT=8080
# BACKEND_PORT=5005
# REDIS_PORT=6379
# MONGO_PORT=27017
